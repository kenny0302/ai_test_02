# ============================================
# AI Processing Platform - Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=ai_platform
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-in-production-use-strong-password

# Database connection string (auto-generated from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me-in-production-use-strong-password

# RabbitMQ connection string (auto-generated from above)
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672

# ============================================
# Redis Configuration
# ============================================
# Redis URL (no password for development, add password in production)
REDIS_URL=redis://redis:6379
# For production with password:
# REDIS_URL=redis://:your-redis-password@redis:6379

# ============================================
# API Service Configuration
# ============================================
NODE_ENV=development
PORT=8080

# JWT Secret - MUST be changed in production!
# Generate with: openssl rand -base64 64
JWT_SECRET=your-secret-key-change-in-production-use-openssl-rand-base64-64

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# ============================================
# External AI Service API Keys (Production)
# ============================================
# Uncomment and configure when using real AI services

# OpenAI Configuration
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4

# Anthropic Claude Configuration
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Google Cloud Speech-to-Text
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# GOOGLE_CLOUD_PROJECT=your-project-id

# AWS Configuration (for Transcribe, Bedrock)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# ============================================
# Monitoring Configuration
# ============================================
# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# Prometheus
PROMETHEUS_RETENTION_TIME=15d

# ============================================
# Application Settings
# ============================================
# Worker Configuration
STT_QUEUE=stt-queue
LLM_QUEUE=llm-queue
DLQ_QUEUE=dlq-queue
MAX_RETRIES=3
WORKER_PREFETCH_COUNT=1

# File Upload Settings
MAX_FILE_SIZE_MB=100
ALLOWED_AUDIO_FORMATS=mp3,wav,m4a,ogg,flac

# Cache Settings
CACHE_TTL_SECONDS=3600  # 1 hour

# ============================================
# Development/Testing
# ============================================
# Enable debug logging
DEBUG=false

# Mock AI services (set to false in production)
MOCK_STT_SERVICE=true
MOCK_LLM_SERVICE=true

# ============================================
# Security Settings
# ============================================
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Session settings
SESSION_SECRET=change-me-in-production-session-secret
SESSION_MAX_AGE=86400000  # 24 hours in milliseconds

# ============================================
# Notes
# ============================================
# 1. Generate strong passwords: openssl rand -base64 32
# 2. Generate JWT secret: openssl rand -base64 64
# 3. Never commit .env file to version control
# 4. Use different secrets for each environment (dev/staging/prod)
# 5. Rotate secrets regularly in production
# 6. Use secret management services (AWS Secrets Manager, HashiCorp Vault) in production
